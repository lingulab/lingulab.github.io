---
import { useTranslations } from '../i18n';
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="section" id="malzeme">
  <div class="split">
    <h2>{t('material.title')}</h2>
    <div class="prose">
      {t('material.paragraphs').map((p: string) => <p>{p}</p>)}
      <p class="small-print">{t('material.note')}</p>
    </div>
  </div>
</section>
