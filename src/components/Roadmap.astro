---
import { useTranslations } from '../i18n';
import { defaultLocale } from '../site.config';
import roadmap from '../data/roadmap.json';
const { lang } = Astro.props;
const t = useTranslations(lang);
const labels: Record<string, string> = t('roadmap.status');
const sorted = [...roadmap].sort((a, b) => a.order - b.order);
const titleOf = (item: (typeof roadmap)[number]) => (item.title as Record<string, string>)[lang] ?? (item.title as Record<string, string>)[defaultLocale];
---
<section class="section" id="yol-haritasi">
  <h2>{t('roadmap.title')}</h2>
  <ol class="path">
    {sorted.map((item, i) => (
      <li class:list={['stop', item.status]}>
        <h3>{i === 0 || sorted[i - 1].status !== item.status ? labels[item.status] : '\u00a0'}</h3>
        <p>{titleOf(item)}</p>
      </li>
    ))}
  </ol>
  <p class="rm-note">{t('roadmap.closing')}</p>
</section>
